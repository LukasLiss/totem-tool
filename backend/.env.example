# Copy to backend/.env (git-ignored) and fill in what you need.
# Variables already set in the real environment take precedence over this file.

# Show the username/password form on the login page. Defaults to DEBUG.
# DEV_LOGIN=1

# OAuth login. A provider is offered only when both its id and secret are set.
# Register <backend origin>/auth/oauth/<provider>/callback/ as the callback URL
# with each provider, e.g. http://localhost:8000/auth/oauth/github/callback/
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Where the backend sends the browser after an OAuth login.
# FRONTEND_URL=http://localhost:3000

# Public backend origin used to build the OAuth callback URL. Set it when the
# backend runs behind a proxy, where the request's own host would be wrong.
# OAUTH_REDIRECT_BASE_URL=https://api.example.com
