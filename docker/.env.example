# Copy to .env in the repository root (next to docker-compose.yml) and fill in
# what you need, then run: docker compose up -d
# At least one login method (password account or an OAuth provider) is needed.

# Address users open in the browser. Use https:// for anything but localhost:
# OAuth login sets a Secure cookie that browsers drop on plain http.
PUBLIC_URL=http://localhost:8000
# Host port to publish the app on (keep in sync with PUBLIC_URL).
# TOTEM_PORT=8000

# Email/password account, created on first start; the password is reset to
# this value on every start.
TOTEM_USER_EMAIL=
TOTEM_USER_PASSWORD=

# OAuth login and registration. A provider is offered only when both its id
# and secret are set.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
