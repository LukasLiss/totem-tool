<?xml version="1.0" encoding="UTF-8"?>
<!-- A small case-centric (XES) log: one trace per order, used to try the
     column-mapping import. Trace attributes become "case:<key>" columns. -->
<log xes.version="1.0" xes.features="nested-attributes" xmlns="http://www.xes-standard.org/">
  <extension name="Concept" prefix="concept" uri="http://www.xes-standard.org/concept.xesext"/>
  <extension name="Time" prefix="time" uri="http://www.xes-standard.org/time.xesext"/>
  <extension name="Organizational" prefix="org" uri="http://www.xes-standard.org/org.xesext"/>
  <extension name="Lifecycle" prefix="lifecycle" uri="http://www.xes-standard.org/lifecycle.xesext"/>
  <global scope="trace">
    <string key="concept:name" value="__INVALID__"/>
  </global>
  <global scope="event">
    <string key="concept:name" value="__INVALID__"/>
    <date key="time:timestamp" value="1970-01-01T00:00:00.000+00:00"/>
  </global>
  <classifier name="Activity" keys="concept:name"/>
  <string key="concept:name" value="Order handling"/>
  <trace>
    <string key="concept:name" value="order-1"/>
    <string key="customer" value="ACME"/>
    <float key="order value" value="1250.0"/>
    <event>
      <string key="concept:name" value="Register order"/>
      <string key="org:resource" value="Alice"/>
      <date key="time:timestamp" value="2024-03-01T09:00:00.000+01:00"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="Check credit"/>
      <string key="org:resource" value="Bob"/>
      <date key="time:timestamp" value="2024-03-01T10:30:00.000+01:00"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="Ship goods"/>
      <string key="org:resource" value="Carol"/>
      <date key="time:timestamp" value="2024-03-02T08:15:00.000+01:00"/>
      <string key="lifecycle:transition" value="complete"/>
      <int key="packages" value="2"/>
    </event>
  </trace>
  <trace>
    <string key="concept:name" value="order-2"/>
    <string key="customer" value="Globex"/>
    <float key="order value" value="80.5"/>
    <event>
      <string key="concept:name" value="Register order"/>
      <string key="org:resource" value="Alice"/>
      <date key="time:timestamp" value="2024-03-01T11:00:00.000+01:00"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="Reject order"/>
      <string key="org:resource" value="Bob"/>
      <date key="time:timestamp" value="2024-03-01T12:00:00.000+01:00"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
  </trace>
  <trace>
    <string key="concept:name" value="order-3"/>
    <string key="customer" value="ACME"/>
    <float key="order value" value="430.0"/>
    <event>
      <string key="concept:name" value="Register order"/>
      <string key="org:resource" value="Dave"/>
      <date key="time:timestamp" value="2024-03-03T09:45:00.000+01:00"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="Check credit"/>
      <string key="org:resource" value="Bob"/>
      <date key="time:timestamp" value="2024-03-03T10:00:00.000+01:00"/>
      <string key="lifecycle:transition" value="complete"/>
    </event>
    <event>
      <string key="concept:name" value="Ship goods"/>
      <string key="org:resource" value="Carol"/>
      <date key="time:timestamp" value="2024-03-04T14:20:00.000+01:00"/>
      <string key="lifecycle:transition" value="complete"/>
      <int key="packages" value="1"/>
    </event>
  </trace>
</log>
